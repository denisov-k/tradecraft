# Your Freicoin payout address: a bech32 address (fc1q...), from the freicoin.ru web wallet,
# freicoin-qt, or contrib/sharechain/swap/newkey.py main. Share chain payouts go here.
FRC_ADDR=fc1q...

# Only for the mergemine profile: where a Bitcoin block reward would go (bc1q...).
BTC_ADDR=

# RPC passwords (internal to the docker network, but change them anyway).
FRC_RPC_PASSWORD=change-me-frc
BTC_RPC_PASSWORD=change-me-btc

# Smallest share difficulty your miners are sent (1000 suits a few TH/s).
MINING_MINDIFF=1000

# Bitcoin node for merge mining: pruned to this many MB of blocks (the UTXO set still needs ~12 GB).
BTC_PRUNE_MB=2000
BTC_DBCACHE=1000

# Build: the branch to build freicoind from, and parallel compile jobs (more RAM per job).
TC_REF=sharechain
BUILD_JOBS=2
